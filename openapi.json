            "title": "Name"
          },
          "unit_price": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Unit Price"
          },
          "available_stock": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Available Stock"
          },
          "active": {
            "type": "boolean",
            "title": "Active",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "name",
          "unit_price",
          "available_stock"
        ],
        "title": "PartUpdate"
      },
      "RequestedItem": {
        "properties": {
          "sku": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Sku"
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "sku",
          "quantity"
        ],
        "title": "RequestedItem"
      },
      "ReserveItems": {
        "properties": {
          "order_id": {
            "type": "string",
            "title": "Order Id"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/RequestedItem"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "items"
        ],
        "title": "ReserveItems"
      },
      "ServiceUpdate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "unit_price": {
